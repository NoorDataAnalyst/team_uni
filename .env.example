# --- Database (PostgreSQL: Neon, Aiven, Supabase... any works) ---
# Neon/Aiven usually need SSL: keep ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth ---
# Long random string, e.g. run: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- AI provider (any OpenAI-compatible chat API with a free tier) ---
# Option A (default): Groq   -> https://console.groq.com/keys
AI_API_KEY="your-provider-key"
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"

# Option B: Google Gemini    -> https://aistudio.google.com/apikey
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_MODEL="gemini-2.5-flash"
